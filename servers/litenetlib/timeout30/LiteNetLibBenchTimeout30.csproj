<Project Sdk="Microsoft.NET.Sdk">

  <!-- 切断までの時間を 30 秒にした LiteNetLib(../Program.cs の LITENETLIB_TIMEOUT30) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);LITENETLIB_TIMEOUT30</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Program.cs" />
    <PackageReference Include="LiteNetLib" Version="2.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../dotnet/BenchKit.CS/BenchKit.CS.csproj" />
  </ItemGroup>

</Project>
